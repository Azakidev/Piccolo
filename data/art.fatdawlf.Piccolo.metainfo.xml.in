<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>art.fatdawlf.Piccolo</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>MIT</project_license>

    <name>Piccolo</name>
    <summary>Color picking with style</summary>
    <description>
        <p>Piccolo is an easy to use color picker and selector, inspired by the venerable gcolor3
            and a spiritual successor to it using modern tooling and a refined UX.</p>
        <p>It provides a color wheel, HSV sliders and a hex code input and it allows to quicky copy
            the selected color as a hex code or any CSS color function in one click.</p>
    </description>

    <developer id="art.fatdawlf">
        <name>FatDawlf</name>
    </developer>

    <url type="homepage">https://github.com/Azakidev/Piccolo</url>
    <url type="vcs-browser">https://github.com/Azakidev/Piccolo</url>
    <url type="bugtracker">https://github.com/Azakidev/Piccolo/issues</url>
    <url type="contact">https://fatdawlf.art</url>

    <translation type="gettext">piccolo</translation>
    <launchable type="desktop-id">art.fatdawlf.Piccolo.desktop</launchable>

    <content_rating type="oars-1.1" />

    <branding>
        <color type="primary" scheme_preference="light">#61bf6f</color>
        <color type="primary" scheme_preference="dark">#27472b</color>
    </branding>

    <screenshots>
        <screenshot type="default" xml:lang="en">
            <image>https://raw.githubusercontent.com/Azakidev/Piccolo/refs/heads/main/dist/ss/1.png</image>
            <caption>The main page of the application</caption>
        </screenshot>
        <screenshot xml:lang="en">
            <image>https://raw.githubusercontent.com/Azakidev/Piccolo/refs/heads/main/dist/ss/2.png</image>
            <caption>The main page of the application with the sidebar expanded</caption>
        </screenshot>
        <screenshot xml:lang="en">
            <image>https://raw.githubusercontent.com/Azakidev/Piccolo/refs/heads/main/dist/ss/3.png</image>
            <caption>The page displaying the history of picked colors in a session.</caption>
        </screenshot>
    </screenshots>

    <releases>
        <release version="0.2.1" date="2026-07-26">
            <url type="details">https://github.com/Azakidev/Piccolo/releases/tag/0.2.1</url>
            <description translate="no">
                <p>Changelog:</p>
                <ul>
                    <li>Fixed color functions and display not using the correct colors due to an issue with the underlying color library</li>
                    <li>Add XYZ-D65 color space to the color functions</li>
                </ul>
            </description>
        </release>
        <release version="0.2.0" date="2026-07-25">
            <url type="details">https://github.com/Azakidev/Piccolo/releases/tag/0.2.0</url>
            <description translate="no">
                <p>Changelog:</p>
                <ul>
                    <li>Add a color history per session</li>
                </ul>
            </description>
        </release>
        <release version="0.1.1" date="2026-05-17">
            <url type="details">https://github.com/Azakidev/Piccolo/releases/tag/0.1.1</url>
            <description translate="no">
                <p>Changelog:</p>
                <ul>
                    <li>Use the correct color space when picking a color using the portal</li>
                    <li>Added the --pick launch argument to immediately request a color before
                        launching the window</li>
                </ul>
            </description>
        </release>
        <release version="0.1.0" date="2026-05-13">
            <url type="details">https://github.com/Azakidev/Piccolo/releases/tag/0.1.0</url>
            <description translate="no">
                <p>Changelog:</p>
                <ul>
                    <li>Initial release!</li>
                </ul>
            </description>
        </release>
    </releases>

</component>
