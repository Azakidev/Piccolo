using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("Shortcuts");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Quit");
      action-name: "app.quit";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Pick a color");
      action-name: "win.pick-color";
      accelerator: "P";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Toggle the sidebar");
      action-name: "win.toggle-sidebar";
      accelerator: "<Ctrl>S";
    }
  }
}
